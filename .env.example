# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# Local infrastructure (replace passwords outside local development)
POSTGRES_DB=collage
POSTGRES_USER=collage
POSTGRES_PASSWORD=collage_local_only
DATABASE_URL=postgresql://collage:collage_local_only@postgres:5432/collage
REDIS_URL=redis://redis:6379

# Public/service URLs
PUBLIC_APP_URL=https://example.ng
API_PUBLIC_URL=https://api.example.ng
MINI_APP_PUBLIC_URL=https://app.example.ng
INTERNAL_API_URL=http://api:4000

# Service ports
API_PORT=4000
BOT_PORT=4001
WORKER_HEALTH_PORT=4002
PORT=3000

# API policy
API_TRUST_PROXY=1
CORS_ALLOWED_ORIGINS=https://app.example.ng
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# Server-only cryptography/service authentication (required later; no values)
APP_ENCRYPTION_KEY_BASE64=
APP_HASH_PEPPER=
INTERNAL_SERVICE_TOKEN=

# Telegram server configuration (no token values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PUBLIC_URL=https://bot.example.ng/telegram/webhook

# Monnify server configuration (Milestone 1 adapter is disabled)
MONNIFY_ENV=sandbox
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_DISBURSEMENT_WALLET_ACCOUNT_NUMBER=
MONNIFY_CARD_TOKENIZATION_ENABLED=false
MONNIFY_DIRECT_DEBIT_ENABLED=false
MONNIFY_DISBURSEMENT_ENABLED=false
MONNIFY_IDENTITY_VERIFICATION_MODE=mock
MONNIFY_DISBURSEMENT_MFA_MODE=manual
MONNIFY_WEBHOOK_REQUIRE_SIGNATURE=false
MONNIFY_WEBHOOK_ALLOWED_IPS=

# Registration providers/policy (not implemented in Milestone 1)
CARD_SETUP_POLICY=commitment_deposit
CARD_SETUP_AMOUNT_MINOR=10000
OTP_PROVIDER=console
OTP_TTL_SECONDS=600
OTP_DEV_CODE=

# Worker boundaries
WORKER_CONCURRENCY_PAYMENTS=5
WORKER_CONCURRENCY_PAYOUTS=2
WORKER_CONCURRENCY_TELEGRAM=10

# Mini App public values only
NEXT_PUBLIC_API_URL=https://api.example.ng
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_MINI_APP_SHORT_NAME=
NEXT_PUBLIC_APP_ENV=development

# Optional observability; enable only after sensitive-data scrubbing
SENTRY_DSN=
SENTRY_ENVIRONMENT=
OTEL_EXPORTER_OTLP_ENDPOINT=
