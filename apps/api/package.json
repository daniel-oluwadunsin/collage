{
  "name": "@collage/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:integration": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@collage/config": "workspace:*",
    "@collage/contracts": "workspace:*",
    "@collage/database": "workspace:*",
    "@collage/logger": "workspace:*",
    "@collage/monnify": "workspace:*",
    "@collage/queue": "workspace:*",
    "@collage/security": "workspace:*",
    "@collage/smsgate": "workspace:*",
    "@collage/telegram": "workspace:*",
    "cors": "2.8.5",
    "express": "5.2.1",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@collage/eslint-config": "workspace:*",
    "@collage/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/cors": "2.8.19",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "catalog:",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "catalog:"
  }
}
