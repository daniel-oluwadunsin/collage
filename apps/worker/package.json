{
  "name": "@collage/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:integration": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@collage/config": "workspace:*",
    "@collage/contracts": "workspace:*",
    "@collage/logger": "workspace:*",
    "bullmq": "5.80.8",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@collage/eslint-config": "workspace:*",
    "@collage/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "6.0.3",
    "eslint": "catalog:",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "catalog:"
  }
}
