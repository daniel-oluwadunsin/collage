FROM node:24.18.0-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.14.0 --activate
WORKDIR /workspace

FROM base AS dependencies
COPY . .
RUN --mount=type=cache,id=collage-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @collage/mini-app... \
    --trust-lockfile --prefer-offline --network-concurrency=4 \
    --fetch-retries=5 --fetch-timeout=120000

FROM dependencies AS builder
ARG NEXT_PUBLIC_API_URL=https://api.example.ng/v1
ARG NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
ARG NEXT_PUBLIC_TELEGRAM_MINI_APP_SHORT_NAME=
ARG NEXT_PUBLIC_APP_ENV=production
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=$NEXT_PUBLIC_TELEGRAM_BOT_USERNAME
ENV NEXT_PUBLIC_TELEGRAM_MINI_APP_SHORT_NAME=$NEXT_PUBLIC_TELEGRAM_MINI_APP_SHORT_NAME
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @collage/mini-app... build

FROM node:24.18.0-alpine AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
RUN addgroup --system --gid 1001 collage && adduser --system --uid 1001 --ingroup collage collage
COPY --from=builder --chown=collage:collage /workspace/apps/mini-app/.next/standalone ./
COPY --from=builder --chown=collage:collage /workspace/apps/mini-app/.next/static ./apps/mini-app/.next/static
USER collage
EXPOSE 3000
CMD ["node", "apps/mini-app/server.js"]
