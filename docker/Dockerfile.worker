FROM node:24.18.0-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.14.0 --activate
WORKDIR /workspace

FROM base AS dependencies
COPY . .
RUN --mount=type=cache,id=collage-pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --filter @collage/worker... \
    --trust-lockfile --prefer-offline \
    --network-concurrency=4 --fetch-retries=5 --fetch-timeout=120000

FROM dependencies AS builder
RUN pnpm --filter @collage/worker... build
RUN pnpm --filter @collage/worker deploy --prod /release

FROM node:24.18.0-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup --system --gid 1001 collage && adduser --system --uid 1001 --ingroup collage collage
COPY --from=builder --chown=collage:collage /release ./
USER collage
EXPOSE 4002
CMD ["node", "dist/index.js"]
