{
  "name": "@collage/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @collage/database prisma:generate",
    "db:migrate": "pnpm --filter @collage/database prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @collage/database prisma:migrate:deploy",
    "docker:build": "docker build -f docker/Dockerfile.api --target runtime . && docker build -f docker/Dockerfile.bot --target runtime . && docker build -f docker/Dockerfile.worker --target runtime . && docker build -f docker/Dockerfile.mini-app --target runtime ."
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.14.0"
  }
}
