{
  "name": "@collage/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@collage/domain": "workspace:*",
    "@collage/security": "workspace:*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@collage/eslint-config": "workspace:*",
    "@collage/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.15.6",
    "eslint": "catalog:",
    "prisma": "7.8.0",
    "tsx": "4.21.0",
    "typescript": "catalog:"
  }
}
